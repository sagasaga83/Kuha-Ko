{
  "name": "@kuhako/web",
  "version": "0.1.0",
  "private": true,
  "description": "The Kuha Ko website.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=../../.env.local db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env.local db/seed.ts"
  },
  "dependencies": {
    "@kuhako/tokens": "*",
    "@kuhako/ui": "*",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kuhako/tsconfig": "*",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "tsx": "4.23.15",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
