{
  "name": "kuha-ko-web",
  "private": true,
  "description": "Kuha Ko: coffee and thrift under one roof in Iloilo City. Turborepo monorepo for the website and shared brand packages.",
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "preview": "npm run preview --workspace @kuhako/web",
    "mobile:sync": "turbo run sync --filter=@kuhako/mobile",
    "mobile:ios": "npm run open:ios --workspace @kuhako/mobile",
    "mobile:android": "npm run open:android --workspace @kuhako/mobile"
  },
  "devDependencies": {
    "turbo": "2.5.8",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
